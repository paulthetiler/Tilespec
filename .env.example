# Dedicated TileSPEC staging project only. No ResinSpec fallback.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TILESPEC-STAGING-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_FROM_PROJECT_SETTINGS
# Every request uses either the signed-in person's own session or, for the public enquiry form
# and shared document links, the publishable key above. The app uses no service-role key: do
# not add one.
# Email alerts for website enquiries (docs/operations/enquiry-notifications.md). Set real values only in the
# hosting settings; never commit them.
# RESEND_API_KEY=
# NOTIFICATIONS_FROM=TileSPEC Website <enquiries@notify.tilespec.uk>
# ENQUIRY_NOTIFICATIONS_TO=info@tilespec.uk
# NOTIFICATIONS_BASE_URL=https://tilespec.uk
# CRON_SECRET=
# ENQUIRY_NOTIFICATIONS_KEY=
