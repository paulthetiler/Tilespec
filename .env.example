# Dedicated TileSPEC staging project only. No ResinSpec fallback.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TILESPEC-STAGING-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_FROM_PROJECT_SETTINGS
# Business requests use user sessions. Snag, stop, daywork and gang photographs and invoices
# are stored and confirmed with the signed-in person's own session and need no key here.
# This optional server-only key is used solely for: office document uploads (verifying
# quarantined file bytes), the public tender enquiry intake and inbox, and shared document
# links. Those features stay switched off without it. It must belong to the SAME dedicated
# project. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
