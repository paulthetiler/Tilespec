# Dedicated TileSPEC staging project only. No ResinSpec fallback.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TILESPEC-STAGING-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_FROM_PROJECT_SETTINGS
# Business requests use user sessions. This server-only key is used solely to
# verify quarantined file bytes before completing a private upload. It must belong
# to the SAME dedicated project. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
